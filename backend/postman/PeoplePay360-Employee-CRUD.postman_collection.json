{
  "info": {
    "name": "PeoplePay360 - HR Manager APIs",
    "description": "HR Manager Employee CRUD and Attendance Create/Read APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "employeeCode",
      "value": "EMP-002"
    },
    {
      "key": "managerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Employees",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees"]
            }
          }
        },
        {
          "name": "Get Employee By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "Create Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('managerId', json.data._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP-001\",\n  \"firstName\": \"Amman\",\n  \"lastName\": \"Malek\",\n  \"email\": \"amman.malek@company.com\",\n  \"phone\": \"+1-555-0100\",\n  \"department\": \"HR\",\n  \"jobPosition\": \"HR Manager\",\n  \"workingSchedule\": \"Standard 40h Week\",\n  \"status\": \"active\",\n  \"hireDate\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees"]
            }
          }
        },
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('employeeId', json.data._id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeCode\": \"EMP-002\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@company.com\",\n  \"phone\": \"+1-555-0200\",\n  \"department\": \"Engineering\",\n  \"jobPosition\": \"Software Engineer\",\n  \"manager\": \"{{managerId}}\",\n  \"workingSchedule\": \"Standard 40h Week\",\n  \"status\": \"active\",\n  \"hireDate\": \"2024-06-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees"]
            }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobPosition\": \"Senior Software Engineer\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Create Employee Attendance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendanceDate\": \"2024-09-05\",\n  \"checkIn\": \"2024-09-05T09:00:00.000Z\",\n  \"checkOut\": \"2024-09-05T18:00:00.000Z\",\n  \"status\": \"present\",\n  \"notes\": \"Regular office attendance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeCode}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeCode}}", "attendance"]
            }
          }
        },
        {
          "name": "Get Employee Attendance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeCode}}/attendance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeCode}}", "attendance"]
            }
          }
        },
        {
          "name": "Get Employee Attendance (Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hr/employees/{{employeeCode}}/attendance?status=present&startDate=2024-09-01&endDate=2024-09-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hr", "employees", "{{employeeCode}}", "attendance"],
              "query": [
                { "key": "status", "value": "present" },
                { "key": "startDate", "value": "2024-09-01" },
                { "key": "endDate", "value": "2024-09-30" }
              ]
            }
          }
        }
      ]
    }
  ]
}
